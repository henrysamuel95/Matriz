# Plantilla de variables de entorno para conexión a SIESA (SQL Server)
# Copia este archivo como '.env' y reemplaza los valores con los tuyos reales.
# NOTA: Asegúrate de que tu archivo '.env' real NUNCA se suba al repositorio.

SIESA_MSSQL_SERVER=192.168.1.100
SIESA_MSSQL_PORT=1433
SIESA_MSSQL_USER=odoo_lectura
SIESA_MSSQL_PASSWORD=mi_password_seguro
SIESA_MSSQL_DATABASE=SiesaUnoEE

# Desactiva la verificación de reCAPTCHA en el login (solo para desarrollo local,
# ya que reCAPTCHA no valida contra localhost). Dejar sin definir o en 0 en cualquier
# ambiente compartido/productivo.
ODOO_DISABLE_RECAPTCHA=0

# Mailpit (servidor SMTP falso para pruebas locales, ver docker-compose.yml
# y models/mailpit_local_dev.py) — nunca entrega correos de verdad, solo
# los captura para verlos en http://localhost:8025.
#
# MAILPIT_LOCAL_DEV=1 activa esto automáticamente al arrancar Odoo (sin
# correr nada a mano) — configura un ir.mail_server hacia Mailpit con
# máxima prioridad, sin tocar ni desactivar el servidor SMTP real. Es una
# variable dedicada solo a esto (no reutiliza ODOO_DISABLE_RECAPTCHA).
# Dejar sin definir o en 0 en cualquier ambiente compartido/productivo —
# como el .env no se sube al repo, en la práctica nunca debería existir
# fuera del .env local de cada desarrollador.
MAILPIT_LOCAL_DEV=0
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025

# Credenciales de Google Drive para desarrollo local (ver
# GoogleDriveAuth.__init__ en models/drive.py). GOOGLE_DRIVE_LOCAL_DEV=1
# hace que se usen config/client_secrets.local.json y
# config/credentials_module.local.json (ambas gitignoreadas) en vez de
# config/client_secrets.json / config/credentials_module.json — así una
# cuenta personal de Google usada solo para probar nunca sobrescribe ni
# depende de las credenciales reales de producción, que quedan en las
# rutas por defecto. También es el interruptor obligatorio para aplicar
# el parámetro Odoo `matriz.firma_test_drive_folder_id`: aunque ese
# parámetro exista, se ignora si esta variable no vale 1/true. Dejar sin
# definir o en 0 en cualquier ambiente compartido/productivo.
GOOGLE_DRIVE_LOCAL_DEV=0
