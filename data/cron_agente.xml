<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_agente_publicador" model="ir.cron">
            <field name="name">SGO: Agente Publicador de Destacados</field>
            <field name="model_id" ref="model_sgo_agente_publicador"/>
            <field name="state">code</field>
            <field name="code">
# Busca el registro del agente configurado y ejecuta su acción
agente = env['sgo.agente.publicador'].search([], limit=1)
if agente:
    agente.accion_crear_publicacion()
            </field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field> <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>