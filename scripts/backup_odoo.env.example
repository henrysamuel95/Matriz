# Copia este archivo a backup_odoo.env y ajusta los valores reales
# del servidor de producción. backup_odoo.env NO debe commitearse
# (ya está listado en .gitignore).

PROD_DB_CONTAINER="postgres_prod"
PROD_ODOO_CONTAINER="odoo_prod"
DB_NAME="mi_base_odoo"
DB_USER="odoo"

# Carpeta donde se guardarán los backups generados en este servidor.
# Se crea una subcarpeta con timestamp en cada corrida.
BACKUP_ROOT="/home/$(whoami)/odoo_backups"

# Estrategia para el filestore: "copy" (Opción A de la guía, docker cp
# directo, más rápido) o "tar" (Opción B, comprime dentro del contenedor
# usando pigz para multinúcleo; genera un solo .tar.gz. El script instala
# pigz automáticamente en el contenedor si no está presente).
FILESTORE_MODE="copy"

# --- Usadas solo por restore_odoo.sh ---
# PROD_DB_CONTAINER y PROD_ODOO_CONTAINER se reutilizan como nombre de
# servicio y de contenedor destino de la restauración (en este repo el
# nombre de servicio y container_name coinciden en docker-compose.yml /
# docker-compose.prod.yml).

# Nombre de la base de datos a crear/restaurar en el destino. Por defecto
# es el mismo DB_NAME de arriba; cámbialo si quieres restaurar el backup
# bajo otro nombre de base de datos.
RESTORE_DB_NAME="$DB_NAME"

# Archivo docker-compose a usar para levantar/apagar el stack durante la
# restauración (Fase 4.1 y 4.4 de la guía). No incluye el contenedor de
# SIESA, que solo aplica a desarrollo.
COMPOSE_FILE="docker-compose.prod.yml"
