                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'orden_sin_fecha'}" class="oe_stat_button" icon="fa-calendar-times-o">
                            <field name="cantidad_orden_sin_fecha" widget="statinfo" string="Orden sin fecha"/>
                            <field name="filtro_activo_orden_sin_fecha" widget="boolean_toggle" class="sgo-filter-active"/>
