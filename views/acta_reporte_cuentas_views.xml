                            <field name="filtro_activo_con_proyecto" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'sin_proyecto'}" class="oe_stat_button" icon="fa-folder-o">
                            <field name="cantidad_sin_proyecto" widget="statinfo" string="Sin proyecto"/>
                            <field name="filtro_activo_sin_proyecto" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'con_factura'}" class="oe_stat_button" icon="fa-file-text">
                            <field name="cantidad_con_factura" widget="statinfo" string="Con factura"/>
                            <field name="filtro_activo_con_factura" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'sin_factura'}" class="oe_stat_button" icon="fa-file-o">
