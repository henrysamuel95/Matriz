    <record id="view_acta_reporte_cuentas_line_search" model="ir.ui.view">
        <field name="name">acta.reporte.cuentas.line.search</field>
        <field name="model">acta.reporte.cuentas.line</field>
        <field name="arch" type="xml">
            <search string="Analizar reporte">
                <field name="nombre_contratista"/>
                <field name="documento_de_identificacion"/>
                <field name="proyecto"/>
                <field name="estado"/>
                <field name="clase_persona"/>
                <field name="tipo_cuenta"/>
                <field name="origen_cuenta"/>
                <field name="pago"/>
                <field name="numero_factura"/>
                <field name="seguimiento_correccion_reporte"/>
                <field name="correccion_reporte_en_manos_de"/>
                <field name="estado_cesion"/>
                <field name="orden_de_pago"/>
                <field name="estado_programacion_pago"/>
                <field name="create_date_origen"/>
                <field name="fecha_solicitud"/>
                <field name="fecha_estado_actual"/>
                <field name="fecha_envio_asis_coordinador"/>
                <field name="fecha_envio_coordinador"/>
                <field name="fecha_envio_ventanilla"/>
                <field name="fecha_envio_director_financiero"/>
                <field name="fecha_firma_director_financiero"/>
                <field name="fecha_envio_contabilidad"/>
                <field name="fecha_envio_auxiliar_tesoreria"/>
                <field name="fecha_envio_tesoreria"/>
                <field name="fecha_finalizacion"/>
                <field name="fecha_rechazo"/>

                <separator/>
                <filter string="Mes/Año de creación" name="reporte_fecha_creacion" date="create_date_origen"/>
                <filter string="Mes/Año de radicación" name="reporte_fecha_radicacion" date="fecha_solicitud"/>
                <filter string="Fecha Asistente coordinación" name="reporte_fecha_asistente" date="fecha_envio_asis_coordinador"/>
                <filter string="Fecha envío Coordinador" name="reporte_fecha_coordinador" date="fecha_envio_coordinador"/>
                <filter string="Fecha envío Ventanilla" name="reporte_fecha_ventanilla" date="fecha_envio_ventanilla"/>
                <filter string="Fecha envío Director Financiero" name="reporte_fecha_director" date="fecha_envio_director_financiero"/>
                <filter string="Fecha firma Director Financiero" name="reporte_fecha_firma_director" date="fecha_firma_director_financiero"/>
                <filter string="Fecha envío Contabilidad" name="reporte_fecha_contabilidad" date="fecha_envio_contabilidad"/>
                <filter string="Fecha envío Auxiliar tesorería" name="reporte_fecha_auxiliar" date="fecha_envio_auxiliar_tesoreria"/>
                <filter string="Fecha envío Tesorería" name="reporte_fecha_tesoreria" date="fecha_envio_tesoreria"/>
                <filter string="Fecha finalización" name="reporte_fecha_finalizacion" date="fecha_finalizacion"/>
                <filter string="Fecha rechazo" name="reporte_fecha_rechazo" date="fecha_rechazo"/>
                <separator/>
                <filter string="Con proyecto" name="reporte_con_proyecto" domain="[('tiene_proyecto', '=', True)]"/>
                <filter string="Sin proyecto" name="reporte_sin_proyecto" domain="[('tiene_proyecto', '=', False)]"/>
                <filter string="Con factura" name="reporte_con_factura" domain="[('tiene_factura', '=', True)]"/>
                <filter string="Sin factura" name="reporte_sin_factura" domain="[('tiene_factura', '=', False)]"/>
                <separator/>
                <filter string="Asistente de coordinación" name="reporte_estado_asistente" domain="[('estado', '=', 'Asistente de coordinación')]"/>
                <filter string="Coordinador" name="reporte_estado_coordinador" domain="[('estado', '=', 'Coordinador')]"/>
                <filter string="Mis pendientes de firma" name="reporte_mis_pendientes" domain="[('mis_pendientes_firma', '=', True)]"/>
                <filter string="Ventanilla" name="reporte_estado_ventanilla" domain="[('estado', '=', 'Ventanilla')]"/>
                <filter string="Director Financiero" name="reporte_estado_director" domain="[('estado', '=', 'Director Financiero')]"/>
                <filter string="Pendientes de firma Director Financiero" name="reporte_pendiente_director" domain="[('pendiente_firma_director_financiero', '=', True)]"/>
                <filter string="Director Financiero - reciente" name="reporte_director_reciente" domain="[('estado', '=', 'Director Financiero')]" context="{'order': 'fecha_envio_director_financiero desc'}"/>
                <filter string="Director Financiero - antiguo" name="reporte_director_antiguo" domain="[('estado', '=', 'Director Financiero')]" context="{'order': 'fecha_envio_director_financiero asc'}"/>
                <filter string="Contabilidad" name="reporte_estado_contabilidad" domain="[('estado', '=', 'Contabilidad')]"/>
                <filter string="Auxiliar de tesorería" name="reporte_estado_auxiliar" domain="[('estado', '=', 'Auxiliar de tesorería')]"/>
                <filter string="Tesorería" name="reporte_estado_tesoreria" domain="[('estado', '=', 'Tesorería')]"/>
                <filter string="Finalizado" name="reporte_finalizadas" domain="[('estado', '=', 'Finalizado')]"/>
                <filter string="Rechazado" name="reporte_rechazadas" domain="[('estado', '=', 'Rechazado')]"/>
                <filter string="Corrección en proceso" name="reporte_correccion" domain="['|', ('correccion_portal_activa', '=', True), ('correccion_reporte_activa', '=', True)]"/>
                <filter string="Con cesión de derechos" name="reporte_cesion" domain="[('cesion_derechos', '=', True)]"/>
                <filter string="Cesión pendiente Jurídica" name="reporte_cesion_juridica" domain="[('estado_cesion', '=', 'Pendiente Jurídica')]"/>
                <filter string="Cesión pendiente Coordinador" name="reporte_cesion_coordinador" domain="[('estado_cesion', '=', 'Pendiente Coordinador')]"/>
                <filter string="Con orden de pago" name="reporte_con_orden" domain="[('orden_de_pago', '!=', '')]"/>
                <filter string="Sin orden de pago" name="reporte_sin_orden" domain="[('orden_de_pago', '=', '')]"/>
                <filter string="Orden cargada sin fecha tentativa" name="reporte_orden_sin_fecha" domain="[('estado_programacion_pago', '=', 'Orden de pago cargada - pendiente fecha tentativa de pago')]"/>

                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Proyecto" name="group_proyecto" context="{'group_by': 'proyecto'}"/>
                    <filter string="Contratista" name="group_contratista" context="{'group_by': 'nombre_contratista'}"/>
                    <filter string="Tipo de persona" name="group_clase_persona" context="{'group_by': 'clase_persona'}"/>
                    <filter string="Tipo de cuenta" name="group_tipo_cuenta" context="{'group_by': 'tipo_cuenta'}"/>
                    <filter string="Mes de creación" name="group_mes_creacion" context="{'group_by': 'create_date_origen:month'}"/>
                    <filter string="Mes de radicación" name="group_mes_radicacion" context="{'group_by': 'fecha_solicitud:month'}"/>
                    <filter string="Mes de finalización" name="group_mes_finalizacion" context="{'group_by': 'fecha_finalizacion:month'}"/>
                    <filter string="Origen" name="group_origen" context="{'group_by': 'origen_cuenta'}"/>
                    <filter string="Estado cesión" name="group_estado_cesion" context="{'group_by': 'estado_cesion'}"/>
                    <filter string="Estado programación pago" name="group_programacion_pago" context="{'group_by': 'estado_programacion_pago'}"/>
                    <filter string="Coordinador asignado" name="group_asignado_coordinador" context="{'group_by': 'asignado_coordinador'}"/>
                    <filter string="Ventanilla asignada" name="group_asignado_ventanilla" context="{'group_by': 'asignado_ventanilla'}"/>
                    <filter string="Contabilidad asignada" name="group_asignado_contabilidad" context="{'group_by': 'asignado_contabilidad'}"/>
                    <filter string="Auxiliar tesorería asignado" name="group_asignado_auxiliar" context="{'group_by': 'asignado_auxiliar_tesoreria'}"/>
                    <filter string="Tesorería asignada" name="group_asignado_tesoreria" context="{'group_by': 'asignado_tesoreria'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_acta_reporte_cuentas_line_pivot" model="ir.ui.view">
        <field name="name">acta.reporte.cuentas.line.pivot</field>
        <field name="model">acta.reporte.cuentas.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de cuentas de cobro">
                <field name="estado" type="row"/>
                <field name="proyecto" type="col"/>
                <field name="cantidad" type="measure"/>
                <field name="valor_cuenta" type="measure"/>
                <field name="horas_duracion_seleccionada" type="measure"/>
                <field name="horas_total_proceso" type="measure"/>
                <field name="horas_estado_actual" type="measure"/>
                <field name="horas_correccion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_acta_reporte_cuentas_line_graph" model="ir.ui.view">
        <field name="name">acta.reporte_cuentas_line.graph</field>
        <field name="model">acta.reporte.cuentas.line</field>
        <field name="arch" type="xml">
            <graph string="Cuentas por estado" type="bar">
                <field name="estado"/>
                <field name="cantidad" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_acta_reporte_cuentas_resultado" model="ir.actions.act_window">
        <field name="name">Resultado del reporte</field>
        <field name="res_model">acta.reporte.cuentas.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_acta_reporte_cuentas_line_tree"/>
        <field name="search_view_id" ref="view_acta_reporte_cuentas_line_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="action_acta_reporte_cuentas_wizard" model="ir.actions.act_window">
        <field name="name">Informes de cuentas de cobro</field>
        <field name="res_model">acta.reporte.cuentas.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_acta_reporte_cuentas_wizard_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <record id="action_server_acta_reporte_cuentas_todas" model="ir.actions.server">
        <field name="name">Informes de cuentas</field>
        <field name="model_id" ref="model_acta_reporte_cuentas_wizard"/>
        <field name="state">code</field>
        <field name="code">wizard = env['acta.reporte.cuentas.wizard'].search([('create_uid', '=', env.user.id)], order='id desc', limit=1)
if not wizard:
    wizard = env['acta.reporte.cuentas.wizard'].create({'name': 'Informes de cuentas de cobro', 'alcance': 'todas', 'etapa_desde': 'fecha_solicitud', 'etapa_hasta': 'fecha_finalizacion', 'orden': 'ultimo_movimiento'})
wizard.write({'name': 'Informes de cuentas de cobro', 'etapa_desde': 'fecha_solicitud', 'etapa_hasta': 'fecha_finalizacion', 'orden': 'ultimo_movimiento', 'filtro_resumen': 'todas', 'filtros_resumen_activos': ''})
wizard.action_ver_todas()
action = env.ref('Matriz.action_acta_reporte_cuentas_wizard').read()[0]
action.update({'res_id': wizard.id, 'target': 'current', 'name': 'Informes de cuentas de cobro'})</field>
    </record>

    <menuitem id="menu_acta_reporte_cuentas"
              name="Informes de cuentas"
              parent="Matriz.menu_actas"
              action="action_server_acta_reporte_cuentas_todas"
              sequence="95"
              groups="Matriz.group_reportes_cuentas_cobro"/>

    <record id="view_acta_pdf_unificado_orden_wizard_form" model="ir.ui.view">
        <field name="name">acta.pdf.unificado.orden.wizard.form</field>
        <field name="model">acta.pdf.unificado.orden.wizard</field>
        <field name="arch" type="xml">
            <form string="Ordenar PDF unificado" create="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Arrastre los documentos para definir el orden. También puede desmarcar un documento si no desea incluirlo en esta generación.
                    </div>
                    <field name="acta_id" invisible="1"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="incluir"/>
                            <field name="etiqueta"/>
                            <field name="drive_id"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_aplicar_y_generar" type="object" string="Generar con este orden" class="btn-primary"/>
                    <button name="action_usar_orden_base" type="object" string="Usar orden base" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_acta_entrega_documentos_pdf_orden_inherit" model="ir.ui.view">
        <field name="name">acta.entrega.documentos.pdf.orden.inherit</field>
        <field name="model">acta_entrega_documentos</field>
        <field name="inherit_id" ref="Matriz.view_acta_entrega_documentos_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//button[@name='action_generar_pdf_unificado'])[1]" position="after">
                <button name="action_ordenar_pdf_unificado"
                        type="object"
                        string="ORDENAR PDF"
                        icon="fa-sort"
                        class="btn btn-secondary"
                        attrs="{'invisible': [('pdf_unificado_estado', '=', 'procesando')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
