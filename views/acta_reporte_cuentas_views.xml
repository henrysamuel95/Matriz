    <record id="view_acta_reporte_cuentas_line_tree" model="ir.ui.view">
        <field name="name">acta.reporte.cuentas.line.tree</field>
        <field name="model">acta.reporte.cuentas.line</field>
        <field name="arch" type="xml">
            <tree string="Reporte de cuentas de cobro" create="0" edit="0" delete="0">
                <field name="nombre_contratista"/>
                <field name="documento_de_identificacion"/>
                <field name="clase_persona" optional="show"/>
                <field name="proyecto" optional="show"/>
                <field name="tipo_cuenta" optional="show"/>
                <field name="origen_cuenta" optional="hide"/>
                <field name="pago" optional="hide"/>
                <field name="numero_factura" optional="hide"/>
                <field name="valor_cuenta" optional="show" sum="Total"/>
                <field name="estado" optional="show"/>
                <field name="estado_visible" optional="hide"/>

                <field name="create_date_origen" optional="show"/>
                <field name="fecha_solicitud" optional="show"/>
                <field name="fecha_estado_actual" optional="show"/>
                <field name="fecha_envio_asis_coordinador" optional="hide"/>
                <field name="fecha_envio_coordinador" optional="hide"/>
                <field name="fecha_envio_ventanilla" optional="hide"/>
                <field name="fecha_envio_director_financiero" optional="hide"/>
                <field name="fecha_firma_director_financiero" optional="hide"/>
                <field name="fecha_envio_contabilidad" optional="hide"/>
                <field name="fecha_envio_auxiliar_tesoreria" optional="hide"/>
                <field name="fecha_envio_tesoreria" optional="hide"/>
                <field name="fecha_finalizacion" optional="show"/>
