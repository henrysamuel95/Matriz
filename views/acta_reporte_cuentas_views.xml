                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'estado_tesoreria'}" class="oe_stat_button" icon="fa-bank">
                            <field name="cantidad_estado_tesoreria" widget="statinfo" string="En Tesorería"/>
                            <field name="filtro_activo_estado_tesoreria" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
