                            <field name="filtro_activo_pendiente_director" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'cesion_juridica'}" class="oe_stat_button" icon="fa-gavel">
