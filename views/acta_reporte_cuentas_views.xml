                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'envio_asistente'}" class="oe_stat_button" icon="fa-user" help="Mostrar las cuentas enviadas a Asistente de coordinación">
                            <field name="cantidad_envio_asistente" widget="statinfo" string="Enviadas a Asistente"/>
                            <field name="filtro_activo_envio_asistente" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'envio_coordinador'}" class="oe_stat_button" icon="fa-user-circle" help="Mostrar las cuentas enviadas al Coordinador">
                            <field name="cantidad_envio_coordinador" widget="statinfo" string="Enviadas a Coordinador"/>
                            <field name="filtro_activo_envio_coordinador" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'envio_ventanilla'}" class="oe_stat_button" icon="fa-inbox" help="Mostrar las cuentas enviadas a Ventanilla">
                            <field name="cantidad_envio_ventanilla" widget="statinfo" string="Enviadas a Ventanilla"/>
                            <field name="filtro_activo_envio_ventanilla" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'envio_director'}" class="oe_stat_button" icon="fa-pencil-square-o" help="Mostrar las cuentas enviadas al Director Financiero">
                            <field name="cantidad_envio_director" widget="statinfo" string="Enviadas a Director"/>
