<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acta_reporte_cuentas_wizard_form" model="ir.ui.view">
        <field name="name">acta.reporte.cuentas.wizard.form</field>
        <field name="model">acta.reporte.cuentas.wizard</field>
        <field name="arch" type="xml">
            <form string="Informes de cuentas de cobro" create="0" delete="0" class="sgo-informes-cuentas-form">
                <header>
                    <button name="action_descargar_excel" type="object" string="Excel" icon="fa-file-excel-o" class="btn-success"/>
                    <button name="action_ver_analisis" type="object" string="Filtros" icon="fa-filter" class="btn-secondary"/>
                    <button name="action_ver_todas" type="object" string="Ver todas" icon="fa-eye" class="btn-secondary"/>
                    <button name="action_limpiar_filtros" type="object" string="Limpiar" icon="fa-eraser" class="btn-secondary"/>
                </header>
                <sheet>
                    <style>
                        .sgo-informes-cuentas-form .o_form_sheet_bg &gt; .o_form_sheet,
                        .sgo-informes-cuentas-form .o_form_sheet {
                            width: calc(100% - 32px) !important;
                            max-width: none !important;
                            min-height: calc(100vh - 135px) !important;
                            margin: 16px auto !important;
                            padding: 24px 28px !important;
                        }
                        .sgo-informes-cuentas-form .o_field_x2many .o_list_renderer {
                            min-height: calc(100vh - 285px) !important;
                            overflow-x: auto !important;
                        }
                        .sgo-informes-cuentas-form .o_field_x2many .o_list_table {
                            min-width: 1650px !important;
                        }
                        .sgo-informes-cuentas-form .o_field_x2many .o_list_table thead th {
                            padding: 13px 10px !important;
                            vertical-align: middle !important;
                        }
                        .sgo-informes-cuentas-form .o_field_x2many .o_list_table tbody td {
                            padding: 10px !important;
                            vertical-align: middle !important;
                        }
                        .sgo-informes-cuentas-form .sgo-filter-active {
                            position: absolute !important;
                            width: 1px !important;
                            height: 1px !important;
                            opacity: 0 !important;
                            pointer-events: none !important;
                            overflow: hidden !important;
                        }
                        .sgo-informes-cuentas-form button.oe_stat_button:has(.sgo-filter-active input:checked) {
                            background-color: #043484 !important;
                            border-color: #043484 !important;
                        }
                        .sgo-informes-cuentas-form button.oe_stat_button:has(.sgo-filter-active input:checked) i,
                        .sgo-informes-cuentas-form button.oe_stat_button:has(.sgo-filter-active input:checked) .o_stat_value,
                        .sgo-informes-cuentas-form button.oe_stat_button:has(.sgo-filter-active input:checked) .o_stat_text {
                            color: #ffffff !important;
                        }
                    </style>
                    <field name="cantidad_resultados" invisible="1"/>
                    <div class="oe_button_box" name="button_box" attrs="{'invisible': [('cantidad_resultados', '=', 0)]}">
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'todas'}" class="oe_stat_button" icon="fa-list-alt" help="Mostrar todas las cuentas de cobro">
                            <field name="cantidad_resultados" widget="statinfo" string="Cuentas"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'en_proceso'}" class="oe_stat_button" icon="fa-spinner" help="Mostrar las cuentas que aún están en proceso">
                            <field name="cantidad_en_proceso" widget="statinfo" string="En proceso"/>
                            <field name="filtro_activo_en_proceso" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'finalizadas'}" class="oe_stat_button" icon="fa-check-circle" help="Mostrar únicamente las cuentas finalizadas">
                            <field name="cantidad_finalizadas" widget="statinfo" string="Finalizadas"/>
                            <field name="filtro_activo_finalizadas" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'rechazadas'}" class="oe_stat_button" icon="fa-times-circle" help="Mostrar únicamente las cuentas rechazadas">
                            <field name="cantidad_rechazadas" widget="statinfo" string="Rechazadas"/>
                            <field name="filtro_activo_rechazadas" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'correccion'}" class="oe_stat_button" icon="fa-exclamation-circle" help="Mostrar las cuentas que tienen una corrección activa">
                            <field name="cantidad_con_correccion" widget="statinfo" string="Con corrección"/>
                            <field name="filtro_activo_correccion" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'cesion'}" class="oe_stat_button" icon="fa-exchange" help="Mostrar las cuentas con cesión de derechos">
                            <field name="cantidad_con_cesion" widget="statinfo" string="Con cesión"/>
                            <field name="filtro_activo_cesion" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'radicadas'}" class="oe_stat_button" icon="fa-paper-plane" help="Mostrar las cuentas radicadas por el contratista">
                            <field name="cantidad_radicadas" widget="statinfo" string="Radicadas contratista"/>
                            <field name="filtro_activo_radicadas" widget="boolean_toggle" class="sgo-filter-active"/>
