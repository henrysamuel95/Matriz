                            <field name="filtro_activo_estado_ventanilla" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'estado_director'}" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="cantidad_estado_director" widget="statinfo" string="En Director"/>
                            <field name="filtro_activo_estado_director" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
