                            <field name="cantidad_estado_contabilidad" widget="statinfo" string="En Contabilidad"/>
                            <field name="filtro_activo_estado_contabilidad" widget="boolean_toggle" class="sgo-filter-active"/>
                        </button>
                        <button name="action_filtrar_resumen" type="object" context="{'filtro_resumen_objetivo': 'estado_auxiliar'}" class="oe_stat_button" icon="fa-credit-card">
