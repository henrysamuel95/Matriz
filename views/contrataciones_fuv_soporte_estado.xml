<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contrataciones_fuv_soporte_estado_wizard_form" model="ir.ui.view">
        <field name="name">contrataciones.fuv.soporte.estado.wizard.form</field>
        <field name="model">contrataciones_fuv.soporte.estado.wizard</field>
        <field name="arch" type="xml">
            <form string="Soporte - Cambiar estado">
                <group>
                    <field name="contratacion_id" readonly="1"/>
                    <field name="flujo_nuevo" invisible="1"/>
                    <field name="persona_juridica" invisible="1"/>
                    <field name="estado_anterior" widget="radio"
                           attrs="{'invisible': [('flujo_nuevo', '=', True)]}"/>
                    <field name="estado_nuevo_natural" widget="radio"
                           attrs="{'invisible': ['|', ('flujo_nuevo', '=', False), ('persona_juridica', '=', True)]}"/>
                    <field name="estado_nuevo_juridica" widget="radio"
                           attrs="{'invisible': ['|', ('flujo_nuevo', '=', False), ('persona_juridica', '=', False)]}"/>
                </group>
                <div class="alert alert-warning" role="alert" style="margin:10px 0 0;">
                    Este cambio es administrativo: no ejecuta los botones de aprobación ni envía sus correos.
                    Se registrará en el historial de la contratación.
                </div>
                <footer>
                    <button name="action_aplicar" type="object" string="Aplicar cambio" class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
