<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contrataciones_sgr_soporte_evento_tree" model="ir.ui.view">
        <field name="name">contrataciones.sgr.soporte.evento.tree</field>
        <field name="model">contrataciones_sgr.soporte.evento</field>
        <field name="arch" type="xml">
            <tree string="Historial de Soporte" create="false" edit="false" delete="false">
                <field name="create_date" string="Fecha"/>
                <field name="usuario_id"/>
                <field name="accion"/>
                <field name="estado_anterior"/>
                <field name="estado_nuevo"/>
                <field name="asignado_anterior_id"/>
                <field name="asignado_nuevo_id"/>
                <field name="retorno_anterior"/>
                <field name="retorno_nuevo"/>
                <field name="motivo"/>
            </tree>
        </field>
    </record>

    <record id="view_contrataciones_sgr_soporte_flujo_wizard_form" model="ir.ui.view">
        <field name="name">contrataciones.sgr.soporte.flujo.wizard.form</field>
        <field name="model">contrataciones_sgr.soporte.flujo.wizard</field>
        <field name="arch" type="xml">
            <form string="Soporte - Diagnosticar flujo SGR">
                <field name="estado_capturado" invisible="1"/>
                <field name="retorno_capturado" invisible="1"/>
                <field name="asignado_capturado_id" invisible="1"/>
                <group>
                    <field name="contratacion_id" readonly="1"/>
                    <field name="estado_actual" readonly="1"/>
                    <field name="estado_retorno" readonly="1"/>
                    <field name="ultimo_usuario_id" readonly="1"/>
                    <field name="asignado_id" readonly="1"/>
                    <field name="diagnostico" readonly="1" nolabel="1"/>
                </group>
                <group string="Reparación">
                    <field name="usuarios_elegibles_ids" invisible="1"/>
                    <field name="usuario_reasignado_id"
                           domain="[('id', 'in', usuarios_elegibles_ids)]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="motivo" placeholder="Explique qué se corrigió"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Con devolución pendiente, seleccione un nuevo revisor para recibir el retorno.
                    Sin devolución, deje el revisor vacío para liberar la asignación.
                    No se envían correos ni se cambia el estado.
                </div>
                <group string="Historial de Soporte">
                    <field name="historial_ids" nolabel="1" readonly="1"
                           context="{'tree_view_ref': 'Matriz.view_contrataciones_sgr_soporte_evento_tree'}"/>
                </group>
                <footer>
                    <button name="action_reparar" type="object" string="Aplicar reparación" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_contrataciones_sgr_soporte_estado_wizard_form" model="ir.ui.view">
        <field name="name">contrataciones.sgr.soporte.estado.wizard.form</field>
        <field name="model">contrataciones_sgr.soporte.estado.wizard</field>
        <field name="arch" type="xml">
            <form string="Soporte - Cambiar estado SGR">
                <field name="estado_capturado" invisible="1"/>
                <field name="retorno_capturado" invisible="1"/>
                <field name="asignado_capturado_id" invisible="1"/>
                <group>
                    <field name="contratacion_id" readonly="1"/>
                    <field name="estado_actual" readonly="1"/>
                    <field name="estado_nuevo"/>
                    <field name="motivo" placeholder="Explique por qué cambia el estado"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Cambio administrativo: limpia la devolución y asignación pendientes.
                    No ejecuta aprobaciones, efectos posteriores ni correos.
                </div>
                <footer>
                    <button name="action_aplicar" type="object" string="Aplicar cambio" class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
