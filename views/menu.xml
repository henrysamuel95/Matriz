        <record id="view_cuentas_de_cobros_search" model="ir.ui.view">
            <field name="name">cuentas_de_cobros.search</field>
            <field name="model">cuentas_de_cobros</field>
            <field name="arch" type="xml">
                <search string="Buscar cuentas de cobro">
                    <field name="name"/>
                    <field name="documento_de_identificacion"/>
                    <field name="proyecto_regalias_id"/>
                    <field name="contrato_regalias_id"/>
                    <filter string="Fundación Univalle" name="filter_cuentas_fuv" domain="[('origen_cuenta', '=', 'fuv')]"/>
                    <filter string="Regalías" name="filter_cuentas_regalias" domain="[('origen_cuenta', '=', 'regalias')]"/>
                    <separator/>
                    <filter string="Agrupar por origen" name="group_origen_cuenta" context="{'group_by': 'origen_cuenta'}"/>
                    <filter string="Agrupar por proyecto Regalías" name="group_proyecto_regalias" context="{'group_by': 'proyecto_regalias_id'}"/>
                    <filter string="Agrupar por contrato Regalías" name="group_contrato_regalias" context="{'group_by': 'contrato_regalias_id'}"/>
                </search>
            </field>
        </record>

