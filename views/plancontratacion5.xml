<odoo>
    <data>
<!-- Vista de formulario para el modelo PlanContratacion -->
        <record id="view_form_plancontratacion" model="ir.ui.view">
            <field name="name">plancontratacion.form</field>
            <field name="model">plancontratacion</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <label for="Ingreso_Nueva_Actividad_a_Contratar_y_Programacion_de_Pagos" string="INGRESO ACTIVIDADES A CONTRATAR" class="oe_inline"/>
                        <span style="display: inline-block; width: 15px;"></span>
                        <button name="Ingreso_Nueva_Actividad_a_Contratar_y_Programacion_de_Pagos" string="INGRESO ACTIVIDADES A CONTRATAR" type="object" class="custom_button_style" style="width: 150px;"/>
                    </header>
                    <style>
                        .custom_button_style {
                        background-color: #485B75;
                        color: white;
                        border: none;
                        padding: 10px 20px;
                        font-size: 16px;
                        border-radius: 5px;
                    }
                    </style>
                    <table>
                        <div class="oe_title">
                            <div class="o_row">
                                <h1>
                                    <div style="display: flex; align-items: center;">
                                        <button name="Guardar" class="custom_button_style" style="width: 50px;" type="object">Guardar</button>
                                        <span style="display: inline-block; width: 15px;"></span>
                                        <field name="new_name" placeholder="Nombre del proyecto" required="1" default_focus="1" class="oe_avatar" style="width: 200px;"></field>
                                    </div>
                                </h1>
                            </div>
                        </div>
                    </table>

                    <table style="width: 100%; border: 1px solid black; background-color: #485B75;">
                        <tr>
                            <td style="text-align: left;">
                                <img src="https://i.ibb.co/D4k0476/imagen1.png" alt="Descripción de la imagen" style="width: 100%; height: auto; max-width: 700px; max-height: 400px; padding-bottom: 15px;" />
                            </td>
                            <td style="text-align: center;">
                                <th colspan="16" style="padding: 8px; font-size: 12px; font-style: italic; font-weight: bold; color: white;">FUNDACION UNIVERSIDAD DEL VALLE<br/>NIT: 800.187.151-9<br/>Flujo de Procesos Internos Contractuales - Modificatorios<br/>Versión 1.0</th>
                            </td>
                            <tr style="background-color: #EFF1F7;">
                            <td colspan="2" style="text-align: right; padding: 6px; border: 1px solid black;">
                                <label for="fecha_emision" style="padding-right: 6px;">Fecha de Emisión:</label>
                                <field name="fecha_emision" style="padding: 6px;"></field>
                            </td>
                        </tr>
                        <tr style="background-color: #EFF1F7;">
                            <td colspan="2" style="text-align: right; padding: 6px; border: 1px solid black;">
                                <label for="fecha_actualizacion" style="padding-right: 6px;">Fecha de Actualización:</label>
                                <field name="fecha_actualizacion" style="padding: 6px;"></field>
                            </td>
                        </tr>
                        <tr style="background-color: #EFF1F7;">
                            <td colspan="2" style="text-align: right; padding: 6px; border: 1px solid black;">
                                <label for="fecha_impresion" style="padding-right: 6px;">Fecha de Impresión:</label>
                                <field name="fecha_impresion" style=" padding: 6px;"></field>
                            </td>
                        </tr>
                       </tr>
                    </table>
                    <notebook>
                        <page string="Tabla de Plan Contratacion">
                            <field name="tabla_contratos" widget="one2many_list">
                                <tree editable="bottom">
                                    <field name="contrato7"/>
                                    <field name="cedula_nit_contratista"/>
                                    <field name="perfil_completo"/>
                                    <field name="cargo_proyecto"/>
                                    <field name="profesion"/>
                                    <field name="titulo_estudios"/>
                                    <field name="objeto"/>
                                    <field name="actividades_especificas"/>
                                    <field name="productos_entregar"/>
                                    <field name="fecha_inicio"/>
                                    <field name="fecha_finalizacion"/>
                                    <field name="tipo_solicitud"/>
                                    <field name="tipo_contrato"/>
                                    <field name="vr_total_contrato"/>
                                    <field name="observaciones_tecnicas"/>
                                    <field name="forma_pago"/>
                                    <field name="fecha_solicitud"/>
                                    <field name="justificacion_solicitud"/>
                                    <field name="cdp_no"/>
                                    <field name="fecha_cdp"/>
                                    <field name="clase_contrato"/>
                                    <field name="descripcion_forma_pago"/>
                                    <field name="quien_solicita"/>
                                    <field name="valor_en_letras"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="view_plancontratacion_tree" model="ir.ui.view" >
            <field name="name">Vista lista de plancontratacion</field>
            <field name="model">plancontratacion</field>
            <field name="arch" type="xml">
                <tree create="1">
                    <field name="new_name"/>
                    <field name="fch_creacion"/>
                    <field name="write_date"/>
                </tree>
            </field>
        </record>

        <record id="view_plancontratacion_kanban" model="ir.ui.view">
            <field name="name">Vista Kanban del Modelo plancontratacion</field>
            <field name="model">plancontratacion</field>
            <field name="arch" type="xml">
                <kanban create="0">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_image">
                                    <img src="https://i.ibb.co/D4k0476/imagen1.png" alt="Descripción de la imagen" style="width: 100%; max-height: 200px; object-fit: cover;" />
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_title">
                                        <field name="new_name"/>
                                    </div>
                                    <div class="o_kanban_record_dates">
                                        <div class="o_kanban_record_date">
                                            <label for="fch_creacion">Fecha de Creación:</label>
                                            <field name="fch_creacion"/>
                                        </div>
                                        <div class="o_kanban_record_date">
                                            <label for="write_date">Última Modificación:</label>
                                            <field name="write_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
      </data>
</odoo>