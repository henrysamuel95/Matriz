<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Define the tree view for Regalias model -->
        <record id="view_regalias_tree" model="ir.ui.view">
            <field name="name">regalias.tree</field>
            <field name="model">regalias</field>
            <field name="arch" type="xml">
                <tree editable="top" limit="20" default_order="id desc">
                    <field name="activity_ids" width="40" string="ASIGNAR TAREA" widget="kanban_activity"/>
                    <field name="name" width="60" optional="show"/>
                    <field name="NOMBRE_DEL_PROCESO" width="60" optional="show" widget="text_preview"/>
                    <field name="TIPO2" width="60" optional="show"/>
                    <field name="MODALIDAD_DE_SELECCION2" width="60" optional="show"/>
                    <field name="CODIGO_SECOP_II" width="60" optional="show"/>
                    <field name="NOMBRE_OBJETO_CONTRATO" width="60" optional="show"/>
                    <field name="CODIGO_UNSPSC" width="60" optional="show"/>
                    <field name="user_id" width="60" optional="show" string="USUARIO ENCARGADO" options="{'no_create': True}"/>
                    <field name="NOMBRE_DEL_CONTRATISTA2" width="60" optional="show"/>
                    <field name="NOMBRE_SUPERVISOR_INICIAL" width="60" optional="show"/>
                    <field name="FECHA_FIRMA_DEL_CONTRATO" width="60" optional="show"/>
                    <field name="FECHA_DE_PUBLICACION_EN_EL_SECOP_II" width="60" optional="hide"/>
                    <field name="VALOR_DEL_CONTRATO_VALOR_DEL_PROCESO" width="60" optional="hide"/>
                    <field name="VALOR_TOTAL_INCLUYE_ADICIONES_HTML" widget="html" options="{'sanitize': false}" optional="hide" width="60" />
                    <field name="CODIGO_CDP" width="60" optional="show" invisible="1"/>
                    <field name="VALOR_CDP_INICIAL" width="60" optional="hide" invisible="1"/>
                    <field name="CODIGO_RPC" width="60" optional="show" invisible="1"/>
                    <field name="VALOR_RPC_INICIAL" width="60" optional="hide" invisible="1"/>
                    <field name="PLAZO_DE_EJECUCION" width="60" optional="hide"/>
                    <field name="FECHA_INICIO_DEL_CONTRATO" width="60" optional="show" widget="date"/>
                    <field name="FECHA_DE_SUSPENSION" width="60"/>
                    <field name="FECHA_DE_REINICIO" width="60"/>
                    <button name="fecha_popup" type="object" class="fa fa-calendar"/>
                    <field name="FECHA_INICIAL_DE_TERMINACION_DEL_CTTO" width="60" optional="hide"/>
                    <field name="FECHA_DE_FINALIZACION_PLAZO_EJECUCION_DEL_CONTRATO" width="60" optional="show"/>
                    <field name="cron_job_id" width="60" optional="show" invisible="1"/>
                    <field name="DIFERENCIA_FECHAS" width="60" optional="show"/>
                    <field name="semaforo_1_color" width="60" widget="color" optional="show"  class="fa-2x"/>
                    <field name="SEMAFORO_1" width="60" optional="show" invisible="1"/>
                    <field name="alert_amarillo_sent" width="60" optional="show" invisible="1"/>
                    <field name="alert_rojo_sent" width="60" optional="show" invisible="1"/>
                    <field name="alert_azul_sent" width="60" optional="show" invisible="1"/>
                    <field name="FECHA_ACTA_DE_TERMINACION_Y_LIQUIDACION3" width="60" optional="hide"/>
                    <field name="FECHA_ACTO_DE_CIERRE_DEL_PROYECTO2" width="60" optional="hide" invisible="1"/>
                    <field name="DECRETO_248_21" width="60" optional="hide" invisible="1"/>
                    <field name="ACUERDO_DE_PAZ" width="60" optional="hide" invisible="1"/>
                    <field name="MATRIZ_DE_AVANCE_PUBLICADA" width="60" optional="hide" invisible="1"/>
                    <field name="MATRIZ_DE_AVANCE_DEL_50" width="60" optional="hide" invisible="1"/>
                    <field name="LINK_SECOP_II" width="60" optional="hide" widget="url"/>
                    <field name="OTROSI_NO_1_PRORROGA_ADICION_MODIFICACION2_HTML" width="60" widget="html" options="{'sanitize': false}" optional="hide" />
                    <field name="FECHA_OTROSI_NO_1" width="60" optional="hide" invisible="1"/>
                    <field name="OTROSI_NO_2_PRORROGA_ADICION_MODIFICACION2" width="60" optional="hide" invisible="1"/>
                    <field name="FECHA_OTROSI_NO_2" width="60" optional="hide" invisible="1"/>
                    <field name="OTROSI_NO_3_PRORROGA_ADICION_MODIFICACION" width="60" optional="hide" invisible="1"/>
                    <field name="FECHA_OTROSI_NO_3" width="60" optional="hide" invisible="1"/>
                    <field name="ESTADO" width="60" optional="show" readonly="1"/>
                    <field name="OBSERVACIONES" width="60" optional="hide"/>
                    <field name="PERSONA_ENCARGADA_FUV" width="60" optional="hide"/>
                </tree>
            </field>
        </record>


                <!-- Define the graph view for Regalias model -->
