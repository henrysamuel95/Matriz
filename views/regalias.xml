        <record id="view_form_valor_total_incluye_adiciones" model="ir.ui.view">
            <field name="name">valor.total.incluye.adiciones.form</field>
            <field name="model">valor_total_incluye_adiciones</field>
            <field name="arch" type="xml">
                <form string="Valor Total Incluye Adiciones">
                    <sheet>
                        <notebook>
                            <page string="Valores">
                                <field name="valor_ids">
                                    <tree editable="bottom" decoration-bf="VALOR_TOTAL_INCLUYE_ADICIONES > 0">
                                        <field name="VALOR_TOTAL_INCLUYE_ADICIONES" width="60" sum="Total"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <group>
                            <group string="Detalles" col="4">
                                <field name="valor_id" invisible="1"/>
                                <field name="VALOR_DEL_CONTRATO_VALOR_DEL_PROCESO" readonly="1" invisible="0"/>
                                <field name="TOTAL" invisible="0"/>
                                <field name="total_tabla" readonly="1" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save_and_reload" type="object" string="Guardar" class="btn-primary"/>
                        <button string="Descartar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


