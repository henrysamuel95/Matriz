                    <field name="NOMBRE_SUPERVISOR_INICIAL" type="row"/>
                    <field name="FECHA_FIRMA_DEL_CONTRATO" type="row"/>
                    <field name="FECHA_DE_PUBLICACION_EN_EL_SECOP_II" type="row"/>
                    <field name="VALOR_DEL_CONTRATO_VALOR_DEL_PROCESO" type="row"/>
                    <field name="VALOR_TOTAL_INCLUYE_ADICIONES" type="row"/>
                    <field name="PLAZO_DE_EJECUCION" type="row"/>
