                    <field name="FECHA_DE_REINICIO" type="row"/>
                    <field name="FECHA_INICIAL_DE_TERMINACION_DEL_CTTO" type="row"/>
                    <field name="FECHA_DE_FINALIZACION_PLAZO_EJECUCION_DEL_CONTRATO" type="row"/>
                    <field name="DIFERENCIA_FECHAS" type="row"/>
                    <field name="SEMAFORO_1" type="row"/>
                    <field name="FECHA_ACTA_DE_TERMINACION_Y_LIQUIDACION3" type="row"/>
