        <record id="view_option_kanban" model="ir.ui.view">
            <field name="name">GO-SGR</field>
            <field name="model">option</field>
            <field name="arch" type="xml">
                <kanban>
                    <templates>
                        <t t-name="kanban-box">
                            <!-- Aquí defines el contenido de la plantilla kanban-box -->
                            <!-- Por ejemplo, puedes incluir etiquetas HTML para mostrar información relevante -->
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="view_regalias_kanban" model="ir.ui.view">
            <field name="name">regalias.kanban.view</field>
            <field name="model">regalias</field>
            <field name="arch" type="xml">
                <kanban create="false" editable="false">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card o_kanban_card_with_semaforo">
                                <div class="o_kanban_color_badge" t-att-style="'background-color: ' + record.semaforo_1_color.raw_value" t-if="record.semaforo_1_color.raw_value"></div>
                                <div class="o_kanban_details">
                                    <div>
                                        <strong>BPIN: </strong>
                                        <field name="name"/>
                                    </div>
                                    <hr style="margin-top: 10px; margin-bottom: 10px;"/>  <!-- Línea horizontal --><div>
                                        <strong>Nombre del Contratista: </strong>
                                        <field name="NOMBRE_DEL_CONTRATISTA2"/>
                                    </div>
                                    <div>
                                        <strong>Nombre del Contrato: </strong>
                                        <field name="NOMBRE_DEL_PROCESO"/>
                                    </div>
                                    <div>
                                        <strong>Código SECOP II: </strong>
                                        <field name="CODIGO_SECOP_II"/>
                                    </div>
                                    <div>
                                        <strong>Nombre / Objeto Contrato: </strong>
                                        <field name="NOMBRE_OBJETO_CONTRATO"/>
                                    </div>
                                    <div>
                                        <strong>Valor del Contrato / Proceso: </strong>
                                        <field name="VALOR_DEL_CONTRATO_VALOR_DEL_PROCESO"/>
                                    </div>
                                    <div>
                                        <strong>Plazo de Ejecución: </strong>
                                        <field name="PLAZO_DE_EJECUCION"/>
                                    </div>
                                    <hr style="margin-top: 10px; margin-bottom: 10px;"/>  <!-- Línea horizontal -->
                                    <div>
                                        <strong>Fecha de Finalización /<br/> Plazo Ejecución del Contrato: </strong>
                                        <field name="FECHA_DE_FINALIZACION_PLAZO_EJECUCION_DEL_CONTRATO"/>
                                    </div>
                                    <hr style="margin-top: 10px; margin-bottom: 10px;"/>  <!-- Línea horizontal -->
                                    <div>
                                        <strong>Link SECOP II: </strong>
                                        <span class="o_kanban_link custom-link">
                                            <field name="LINK_SECOP_II" widget="url"/>
                                        </span>
                                    </div>

                                    <hr style="margin-top: 10px; margin-bottom: 10px;"/>
                                    <div>
                                        <strong>Estado </strong>
                                        <field name="ESTADO"/>
                                    </div>
                                    <hr style="margin-top: 10px; margin-bottom: 10px;"/>
                                    <strong>Semaforo </strong>
                                    <field name="semaforo_1_color" invisible="0" widget="color"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>







