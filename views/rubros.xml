                                    <field name="Periodo29" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo30" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <table style="width: 100%">
                        <separator colspan="4" style="border-top:2px solid #000000;"/>
                        <div class="oe_chatter">
                            <field name="message_follower_ids"/>
                            <field name="activity_ids"/>
                            <field name="message_ids"/>
                        </div>
                    </table>
                </form>
            </field>
        </record>

