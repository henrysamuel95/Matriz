<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Define the view -->
        <record model="ir.ui.view" id="view_rubros_form">
            <field name="name">rubros.form</field>
            <field name="model">rubros</field>
            <field name="arch" type="xml">
                <form string="Tareas" create="0">
                    <div style="width: auto; border: 0.1px solid black; padding: 5px; background: #6ed84a;" invisible="1">
                        <strong>Editar o no editar </strong>
                        <field name="is_editable" widget="boolean_toggle" invisible="1"/>
                    </div>
                    <field name="entregable_id" invisible="1"/>
                    <style>
                            .modal-dialog {
                            width: 100%; /* Ajusta el ancho según tus necesidades */
                            max-width: 1100px; /* Establece un ancho máximo si lo deseas */
                            margin: 60px auto; /* Controla el margen al centro */
                        }
                            .custom_button_style {
                            background-color: #485B75;
                            color: white;
                            border: none;
                            padding: 10px 20px;
                            font-size: 16px;
                            border-radius: 5px;
                        }
                        </style>
                    <div>
                         <strong>ACCION </strong><field name="name" style="display: inline-block; width: 500px;" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                        <button name="datos" type="object"  class="fa fa-search" title="Cargar o ver datos"  />
                    </div>
                    <notebook>
                        <page string="Tareas">
                            <field name="tareas_ids" widget="one2many" style="width: 2200px">
                                <tree editable="bottom" col="39">
                                    <field name="is_editable" widget="boolean_toggle" invisible="1"/>
                                    <field name="hiden" widget="handle" width="45"/>
                                    <field name="n_tareas" width="60" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="otros_tareas2" width="60" string="CONTRATISTAS" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="proyecto_relacionado" invisible="1"/>
                                    <button name="action_ingresar_tareas" type="object" class="fa fa-arrow-right" invisible="1"/>
                                    <field name="estado" width="60" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="verificador" width="70" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="unidad_medida" width="70" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="cantidad" width="60" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="porcentaje" width="70" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="duracion_periodos" width="70" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="fecha_inicio" width="60" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="fecha_fin" width="60" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo1" width="60" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo2" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo3" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo4" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo5" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo6" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo7" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo8" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo9" width="30" optional="show" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo10" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo11" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo12" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
                                    <field name="Periodo13" width="30" optional="hide" attrs="{'readonly': [('is_editable', '=', True)]}"/>
