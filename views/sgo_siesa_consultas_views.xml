<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sql_form" model="ir.ui.view">
        <field name="name">sql.form</field>
        <field name="model">sql</field>
        <field name="arch" type="xml">
            <form string="Integración SQL Siesa">
                <header>
                    <button name="sync_tabla_prueba" string="1. Sincronizar Siesa" type="object" class="oe_highlight"/>
                    <button name="action_ver_movimientos_validados" string="2. Ver Conciliación Universal" type="object" class="btn-primary" icon="fa-check-circle"/>
                </header>
                <sheet>
                    <group>
                        <field name="selected_table" string="Tabla Base"/>
                        <field name="available_tables" string="Estado de Tablas" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sql_tree" model="ir.ui.view">
        <field name="name">sql.tree</field>
        <field name="model">sql</field>
        <field name="arch" type="xml">
            <tree string="Configuración SQL">
                <field name="selected_table"/>
                <button name="action_ver_movimientos_validados" string="Ir a Conciliación" type="object" icon="fa-list-alt"/>
            </tree>
        </field>
    </record>

    <record id="view_tabla_resumen_search" model="ir.ui.view">
       <field name="name">tabla.resumen.tercero.search</field>
       <field name="model">tabla.resumen.tercero</field>
       <field name="arch" type="xml">
           <search>
               <field name="tercero" string="NIT / Cédula"/>
               <field name="razon_social"/>
               <field name="id_un" string="Unidad de Negocio"/>
           </search>
       </field>
    </record>

    <record id="view_tabla_resumen_tree" model="ir.ui.view">
        <field name="name">tabla.resumen.tercero.tree</field>
        <field name="model">tabla.resumen.tercero</field>
        <field name="arch" type="xml">
            <tree string="Resumen por Terceros">
                <field name="id_un" string="U.N."/>
                <field name="tercero" string="NIT"/>
                <field name="razon_social" string="Razón Social"/>
                <field name="total_debitos" sum="Total Pagos"/>
                <field name="total_creditos" sum="Total Deuda"/>
            </tree>
        </field>
    </record>

    <record id="view_tabla_resumen_form" model="ir.ui.view">
        <field name="name">tabla.resumen.tercero.form</field>
        <field name="model">tabla.resumen.tercero</field>
        <field name="arch" type="xml">
            <form string="Detalle del Tercero">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="razon_social" readonly="1"/></h1>
                        <h3>NIT: <field name="tercero" readonly="1"/></h3>
                    </div>
                    <notebook>
                        <page string="Movimientos en Siesa">
                            <field name="linea_ids" readonly="1">
                                <tree decoration-info="id_tipo_docto in ['FP', 'S4']">
                                    <field name="fecha_docto"/>
                                    <field name="id_tipo_docto" string="Tipo"/>
                                    <field name="nro_docto" string="# Doc"/>
                                    <field name="debitos"/>
                                    <field name="creditos"/>
                                    <field name="nro_cruzado" string="Cruzado Con"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tabla_prueba_search" model="ir.ui.view">
        <field name="name">tabla.prueba.search</field>
        <field name="model">tabla.prueba</field>
        <field name="arch" type="xml">
            <search>
                <field name="tercero"/>
                <field name="razon_social"/>
                <field name="nro_cruzado"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Por Factura Padre" name="group_cruce" context="{'group_by':'nro_cruzado'}"/>
                    <filter string="Por Tercero" name="group_tercero" context="{'group_by':'tercero'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tabla_prueba_conciliacion_tree" model="ir.ui.view">
        <field name="name">tabla.prueba.conciliacion.tree</field>
        <field name="model">tabla.prueba</field>
        <field name="arch" type="xml">
            <tree string="Conciliación" create="0" decoration-info="id_tipo_docto in ['FP', 'S4']">
                <field name="tercero"/>
                <field name="razon_social"/>
                <field name="id_tipo_docto" string="Tipo"/>
                <field name="nro_docto" string="# Doc"/>
                <field name="fecha_docto"/>
                <field name="debitos" string="Pagos/Retenciones" sum="Total Pagos"/>
                <field name="creditos" string="Deuda Original" sum="Total Deuda"/>
                <field name="nro_cruzado" string="ID Cruce"/>
            </tree>
        </field>
    </record>

    <record id="action_tabla_resumen" model="ir.actions.act_window">
        <field name="name">Registros por NIT</field>
        <field name="res_model">tabla.resumen.tercero</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay registros de terceros.
            </p>
        </field>
    </record>

    <record id="action_sql_config" model="ir.actions.act_window">
        <field name="name">Configuración SQL</field>
        <field name="res_model">sql</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem id="menu_siesa_root" name="Integración Siesa" sequence="1"/>
    <menuitem id="menu_siesa_resumen" name="Registros por NIT" parent="menu_siesa_root" action="action_tabla_resumen" sequence="10"/>
    <menuitem id="menu_siesa_config" name="Configuración SQL" parent="menu_siesa_root" action="action_sql_config" sequence="20"/> -->
</odoo>
