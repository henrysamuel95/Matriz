<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_inventario_documental_form" model="ir.ui.view">
        <field name="name">inventario.documental.form</field>
        <field name="model">inventario.documental</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_generar_excel"
                            string="Generar y subir a Drive"
                            type="object"
                            class="oe_highlight"
                            icon="fa-file-excel-o"
                            invisible="1"
                            attrs="{'invisible': [('can_edit_inventory', '=', False)]}"/>
                    <button name="action_actualizar_lineas_carpetas"
                            string="Actualizar carpetas"
                            type="object"
                            icon="fa-refresh"
                            invisible="1"
                            attrs="{'invisible': [('can_edit_inventory', '=', False)]}"/>
                    <button name="action_abrir_drive"
                            string="Abrir en Drive"
                            type="object"
                            icon="fa-external-link"
                            invisible="1"/>
                    <button name="action_compartir_drive"
                            string="Compartir"
                            type="object"
                            icon="fa-share-alt"
                            attrs="{'invisible': [('can_edit_inventory', '=', False)]}"/>
                    <button name="action_compartir_formulario_odoo"
                            string="Compartir formulario"
                            type="object"
                            icon="fa-users"
                            attrs="{'invisible': [('can_edit_inventory', '=', False)]}"/>
                    <field name="drive_id" invisible="1"/>
                    <field name="drive_url" invisible="1"/>
                    <field name="project_user_ids" invisible="1"/>
                    <field name="can_edit_inventory" invisible="1"/>
                    <field name="can_comment_inventory" invisible="1"/>
                </header>
                <sheet style="max-width:100% !important; width:100% !important; margin:0 !important; padding:15px !important;">
                    <style>
                        .o_form_sheet { max-width:100% !important; width:100% !important; margin:0 !important; }
                        .fuid_brd  { border:1px solid black; width:100%; box-sizing:border-box; overflow:hidden; }
                        .fuid_brd * { box-sizing:border-box; }
                        /* ── Quitar bordes y fondo de los inputs dentro del formulario para verse como texto plano ── */
                        .inv_entity_tbl td .o_field_widget input,
                        .inv_entity_tbl td .o_field_widget .o_input,
                        .inv_entity_tbl td .o_field_widget span { border:none !important; box-shadow:none !important; background:transparent !important; padding:0 !important; height:auto !important; line-height:inherit !important; }
                        .inv_ctrl_box .o_field_widget input,
                        .inv_ctrl_box .o_field_widget .o_input { border:none !important; box-shadow:none !important; background:transparent !important; padding:0 !important; text-align:center !important; width:auto !important; min-width:0 !important; }
                        .inv_transfer_cell .o_field_widget,
                        .inv_transfer_cell .o_field_widget input,
                        .inv_transfer_cell .o_field_widget .o_input,
                        .inv_transfer_cell .o_field_widget textarea { display:block !important; width:100% !important; max-width:100% !important; min-height:36px !important; border:none !important; box-shadow:none !important; background:transparent !important; text-align:left !important; }
                        /* ── Quitar borde superior del tree para que se vea continuo ── */
                        .inv_tree_wrap { width:100%; max-width:100%; overflow-x:auto; overflow-y:hidden; box-sizing:border-box; }
                        .inv_tree_wrap .o_list_view { border-top:none !important; max-width:100% !important; }
                        .inv_tree_wrap .o_list_table { border-top:none !important; }
                        .inv_tree_wrap .o_list_table thead th { background:#efefef !important; font-size:10px !important; padding:3px 4px !important; border:1px solid black !important; white-space:nowrap !important; word-break:keep-all !important; overflow:hidden !important; text-overflow:ellipsis !important; }
                        .inv_tree_wrap .o_list_table thead th * { white-space:nowrap !important; word-break:keep-all !important; }
                    </style>

                    <!-- ═══════════ ENCABEZADO ═══════════ -->
                    <div class="fuid_brd" style="display:flex; align-items:stretch; margin-bottom:-1px;">
                        <div style="flex:0 0 13%; border-right:1px solid black; text-align:center; padding:6px; display:flex; align-items:center; justify-content:center;">
                            <img src="/Matriz/static/src/img/LogoFUV.png" style="max-height:72px; max-width:100%;" alt="Logo FUV"/>
                        </div>
                        <div style="flex:1; border-right:1px solid black; text-align:center; padding:10px; display:flex; flex-direction:column; align-items:center; justify-content:center;">
                            <div style="font-weight:bold; font-size:14px; letter-spacing:1px;">FORMATO ÚNICO DE INVENTARIO DOCUMENTAL</div>
                            <div style="font-size:10px; margin-top:2px;">FUNDACIÓN UNIVERSIDAD DEL VALLE</div>
                        </div>
                        <div style="flex:0 0 17%; padding:8px; font-size:10px; text-align:center; line-height:2; display:flex; flex-direction:column; justify-content:center;">
                            <div><b>F.EMISIÓN:</b>  2020-01-23</div>
                            <div><b>Versión:</b>  2</div>
                            <div><b>CÓDIGO:</b>  <field name="referencia" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                        </div>
                    </div>

                    <!-- ═══════════ DATOS ENTIDAD + CONTROL ═══════════ -->
                    <div class="fuid_brd" style="display:flex; margin-bottom:8px; margin-top:-1px;">
                        <!-- Izquierda: datos entidad (74%) -->
                        <div style="flex:0 0 74%; border-right:1px solid black;">
                            <table style="width:100%; border-collapse:collapse; table-layout:fixed; font-size:11px;">
                                <tr style="border-bottom:1px solid black;">
                                    <td style="padding:3px 6px; width:210px; font-weight:bold; white-space:nowrap; vertical-align:middle;">ENTIDAD REMITENTE:</td>
                                    <td style="padding:3px 6px; vertical-align:middle;"><field name="entidad_remitente" nolabel="1" style="width:100%;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></td>
                                </tr>
                                <tr style="border-bottom:1px solid black;">
                                    <td style="padding:3px 6px; font-weight:bold; white-space:nowrap; vertical-align:middle;">ENTIDAD PRODUCTORA:</td>
                                    <td style="padding:3px 6px; vertical-align:middle;"><field name="entidad_productora" nolabel="1" style="width:100%;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></td>
                                </tr>
                                <tr style="border-bottom:1px solid black;">
                                    <td style="padding:3px 6px; font-weight:bold; white-space:nowrap; vertical-align:middle;">UNIDAD ADMINISTRATIVA:</td>
                                    <td style="padding:3px 6px; vertical-align:middle;"><field name="unidad_administrativa" nolabel="1" style="width:100%;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></td>
                                </tr>
                                <tr style="border-bottom:1px solid black;">
                                    <td style="padding:3px 6px; font-weight:bold; white-space:nowrap; vertical-align:middle;">UNIDAD PRODUCTORA:</td>
                                    <td style="padding:3px 6px; vertical-align:middle;"><field name="unidad_productora" nolabel="1" style="width:100%;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding:3px 6px; font-size:11px;">
                                        <b>OBJETO:</b>
                                        <span style="display:inline-flex; flex-wrap:wrap; gap:14px; margin-left:6px; font-size:10px; vertical-align:middle;">
                                            <span style="display:inline-flex; align-items:center; gap:3px;"><field name="obj_trans_primaria" nolabel="1" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/> Transferencia Primaria</span>
                                            <span style="display:inline-flex; align-items:center; gap:3px;"><field name="obj_trans_secundaria" nolabel="1" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/> Transferencia secundaria</span>
                                            <span style="display:inline-flex; align-items:center; gap:3px;"><field name="obj_val_fondos" nolabel="1" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/> Valoración de fondos acumulados</span>
                                        </span>
                                        <br/>
                                        <span style="display:inline-flex; flex-wrap:wrap; gap:14px; margin-left:6px; margin-top:4px; font-size:10px; vertical-align:middle;">
                                            <span style="display:inline-flex; align-items:center; gap:3px;"><field name="obj_fusion" nolabel="1" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/> Fusión y supresión de áreas</span>
                                            <span style="display:inline-flex; align-items:center; gap:3px;"><field name="obj_inv_indiv" nolabel="1" class="oe_inline" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/> Inventarios individuales por vinculación, traslado o desvinculación</span>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <!-- Derecha: control (26%) -->
                        <div style="flex:0 0 26%; display:flex; flex-direction:column;">
                            <div style="border-bottom:1px solid black; text-align:center; padding:7px; font-weight:bold; font-size:11px;">
                                HOJA&#160;
                                <field name="hoja_actual" nolabel="1" class="oe_inline" style="width:26px; text-align:center;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                &#160;DE&#160;
                                <field name="hoja_total" nolabel="1" class="oe_inline" style="width:26px; text-align:center;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                            </div>
                            <div style="border-bottom:1px solid black; padding:6px; font-size:10px;">
                                <div style="font-weight:bold; text-align:center; margin-bottom:4px;">REGISTRO DE ENTRADA</div>
                                <div style="display:flex; align-items:center; gap:4px;">
                                    <b>DÍA</b> <field name="dia_header" nolabel="1" class="oe_inline" style="width:26px;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                    <b>MES</b> <field name="mes_header" nolabel="1" class="oe_inline" style="width:26px;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                    <b>AÑO</b> <field name="anio_header" nolabel="1" class="oe_inline" style="width:40px;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                </div>
                            </div>
                            <div class="inv_transfer_cell" style="padding:6px; font-size:10px; flex:1;">
                                <div style="font-weight:bold; text-align:center; margin-bottom:4px;">TRANSFERENCIA</div>
                                <field name="registro_transferencia" nolabel="1" class="inv_transfer_field" style="width:100%;" attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                            </div>
                        </div>
                    </div>

                    <!-- ═══════════ TABLA DE REGISTROS ═══════════ -->
                    <div class="inv_tree_wrap">
                        <field name="linea_ids" nolabel="1">
                            <tree editable="bottom" string=" " delete="false">
                                <field name="can_edit_line" invisible="1"/>
                                <field name="can_comment_line" invisible="1"/>
                                <field name="can_observe_line" invisible="1"/>
                                <field name="numero_orden"        string="N. Orden"                        width="65"/>
                                <field name="codigo_trd"          string="Codigo"                          width="100" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="nombre_serie"        string="Nombre Serie, Sub serie o asunto" width="270" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="folios"              string="Folios"       width="55" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="fecha_inicial"       string="Inicial"      width="100" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="fecha_final"         string="Final"        width="100" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="caja"                string="Caja"         width="55" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="carpeta"             string="Carpeta"      width="60" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="es_digital"          string="Digital"      width="55" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="otro_soporte"        string="Otro"         width="55" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="frecuencia_consulta" string="Frecuencia de Consulta (Alta, Media o Baja)" width="150" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="soporte_especial"    string="Soportes (Si o No)" width="100" attrs="{'readonly': [('can_edit_line', '=', False)]}"/>
                                <field name="observaciones"       string="Observaciones - El tipo de soportes diferente al papel que acompaña la carpeta" attrs="{'readonly': [('can_observe_line', '=', False)]}"/>
                                <field name="comentario"          string="Comentario" width="220" attrs="{'readonly': [('can_comment_line', '=', False)]}"/>
                            </tree>
                        </field>
                    </div>

                    <!-- ═══════════ FIRMAS ═══════════ -->
                    <div class="mt-3" style="display:flex; justify-content:space-between; gap:8px;">
                        <div style="width:33%; border:1px solid black; background-color:white;">
                            <div style="background-color:#eee; border-bottom:1px solid black; padding:2px; font-weight:bold; font-size:10px; text-align:center;">Elaborado por</div>
                            <div style="padding:5px; font-size:10px;">
                                <field name="elaborado_log_id" invisible="1"/>
                                <field name="elaborado_firma_hash" invisible="1"/>
                                <div style="margin-bottom:2px; display:flex; align-items:center; gap:6px;">
                                    <b>Nombre:</b>
                                    <field name="elaborado_nombre" nolabel="1" placeholder="Nombre..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                    <field name="elaborado_firmado" nolabel="1" readonly="1"/>
                                </div>
                                <div style="margin-bottom:2px;"><b>Oficina:</b> <field name="elaborado_oficina" nolabel="1" placeholder="Oficina..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                                <div style="margin-bottom:2px;"><b>Cargo:</b> <field name="elaborado_cargo" nolabel="1" placeholder="Cargo..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                            </div>
                        </div>
                        <div style="width:33%; border:1px solid black; background-color:white;">
                            <div style="background-color:#eee; border-bottom:1px solid black; padding:2px; font-weight:bold; font-size:10px; text-align:center;">Entregado por</div>
                            <div style="padding:5px; font-size:10px;">
                                <field name="entregado_log_id" invisible="1"/>
                                <field name="entregado_firma_hash" invisible="1"/>
                                <div style="margin-bottom:2px; display:flex; align-items:center; gap:6px;">
                                    <b>Nombre:</b>
                                    <field name="entregado_nombre" nolabel="1" placeholder="Nombre..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                    <field name="entregado_firmado" nolabel="1" readonly="1"/>
                                </div>
                                <div style="margin-bottom:2px;"><b>Oficina:</b> <field name="entregado_oficina" nolabel="1" placeholder="Oficina..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                                <div style="margin-bottom:2px;"><b>Cargo:</b> <field name="entregado_cargo" nolabel="1" placeholder="Cargo..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                            </div>
                        </div>
                        <div style="width:33%; border:1px solid black; background-color:white;">
                            <div style="background-color:#eee; border-bottom:1px solid black; padding:2px; font-weight:bold; font-size:10px; text-align:center;">Recibido por</div>
                            <div style="padding:5px; font-size:10px;">
                                <field name="recibido_log_id" invisible="1"/>
                                <field name="recibido_firma_hash" invisible="1"/>
                                <div style="margin-bottom:2px; display:flex; align-items:center; gap:6px;">
                                    <b>Nombre:</b>
                                    <field name="recibido_nombre" nolabel="1" placeholder="Nombre..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/>
                                    <field name="recibido_firmado" nolabel="1" readonly="1"/>
                                </div>
                                <div style="margin-bottom:2px;"><b>Oficina:</b> <field name="recibido_oficina" nolabel="1" placeholder="Oficina..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                                <div style="margin-bottom:2px;"><b>Cargo:</b> <field name="recibido_cargo" nolabel="1" placeholder="Cargo..." attrs="{'readonly': [('can_edit_inventory', '=', False)]}"/></div>
                            </div>
                        </div>
                    </div>
                     <br/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vista_inventario_documental_compartir_wizard" model="ir.ui.view">
        <field name="name">inventario.documental.compartir.wizard.form</field>
        <field name="model">inventario.documental.compartir.wizard</field>
        <field name="arch" type="xml">
            <form string="Compartir formulario Odoo">
                <style>
                    .modal-dialog { max-width: 560px; margin: 60px auto; }
                    .inv_share_title { font-size: 18px; font-weight: 600; color: #0f172a; margin-bottom: 20px; }
                    .inv_share_section { font-size: 13px; font-weight: 500; color: #334155; margin: 16px 0 8px; }
                    .inv_share_input { display: flex; align-items: center; border: 1px solid #1a73e8; border-radius: 4px; padding: 4px 10px; margin-bottom: 14px; gap: 8px; }
                    .inv_share_input .o_field_widget { flex: 1; border: none !important; box-shadow: none !important; }
                    .inv_share_role { display: flex; align-items: center; gap: 10px; border: 1px solid #cbd5e1; border-radius: 24px; padding: 6px 16px; width: fit-content; }
                    .inv_share_role .o_field_widget { border: none !important; box-shadow: none !important; }
                    .inv_share_hint { background: #eff6ff; border-left: 4px solid #003b8f; padding: 10px 12px; color: #1e3a8a; font-size: 12px; margin-top: 12px; }
                </style>
                <sheet>
                    <field name="inventario_id" invisible="1"/>
                    <div class="inv_share_title">
                        <i class="fa fa-users" style="color:#003b8f; margin-right:8px;"/>Compartir formulario
                    </div>

                    <div class="inv_share_section">Usuarios permitidos del proyecto</div>
                    <field name="project_user_ids" widget="many2many_tags" readonly="1" nolabel="1" options="{'no_open': True}"/>

                    <div class="inv_share_section">Seleccionar usuario</div>
                    <div class="inv_share_input">
                        <i class="fa fa-search" style="color:#64748b;"/>
                        <field name="user_id" placeholder="Buscar usuario del proyecto..." nolabel="1" options="{'no_create': True, 'no_open': True}" domain="[('id', 'in', context.get('allowed_user_ids', []))]"/>
                    </div>

                    <div class="inv_share_section">
                        <i class="fa fa-lock" style="color:#64748b; margin-right:6px;"/>Permiso
                    </div>
                    <div class="inv_share_role">
                        <i class="fa fa-chevron-down" style="color:#64748b;"/>
                        <field name="role" nolabel="1"/>
                    </div>
                    <div class="inv_share_hint">
                        Lector puede ver. Observaciones permite escribir sólo en la columna Observaciones. Comentario permite escribir sólo en la columna Comentario. Editor permite agregar líneas y modificar sólo las líneas propias.
                    </div>

                    <div class="inv_share_section">Mensaje del correo</div>
                    <field name="message" nolabel="1" placeholder="Mensaje para el usuario..." style="min-height:80px;"/>
                </sheet>
                <footer>
                    <button name="action_share" type="object" string="Compartir" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
